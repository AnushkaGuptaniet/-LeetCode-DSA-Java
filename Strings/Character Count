public class CharacterCount {
    public static void main(String[] args) {
        String s = "helloworld";
        int len = 10;
        char c = 'l';
        int count = 0;
        for(int i = 0; i < len; i++){
            if(s.charAt(i) == c){
                count++;
            }
        }
        System.out.println(count);
    }
}
// TC : O(N), SC : O(1)
